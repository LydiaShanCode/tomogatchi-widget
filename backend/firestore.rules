rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function paired(pairID) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pairID == pairID
        && (get(/databases/$(database)/documents/pairs/$(pairID)).data.parentID == request.auth.uid
          || get(/databases/$(database)/documents/pairs/$(pairID)).data.childID == request.auth.uid);
    }
    match /users/{uid} { allow get: if signedIn() && request.auth.uid == uid; allow list, write: if false; }
    match /pairs/{pairID} {
      allow get: if paired(pairID); allow list, write: if false;
      match /gifts/{giftID} { allow read: if paired(pairID); allow write: if false; }
      match /meals/{mealID} { allow read: if paired(pairID); allow write: if false; }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
